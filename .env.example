# AGENTPROOF_DISPLAY_TIME_BUCKET_MS=320
# AGENTPROOF_DISPLAY_GRID_PX=28
# AGENTPROOF_DISPLAY_JITTER_PX=10
# AGENTPROOF_DISPLAY_EMA_ALPHA=0.5
# AGENTPROOF_DISPLAY_WOBBLE_PX=28
# AGENTPROOF_DISPLAY_LAG_MS=700
